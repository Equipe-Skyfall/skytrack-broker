# ESP32 Sensor Data Server - Environment Configuration
# Copy this file to .env and fill in your actual values

# ======================
# MongoDB Configuration
# ======================

# MongoDB connection string (required)
MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=cluster0

# Database name (optional, defaults to 'dadosClima')
MONGO_DATABASE=dadosClima

# ======================
# Server Configuration
# ======================

# Port for the HTTP server (optional, defaults to 3000)
PORT=3000

# ======================
# Queue Configuration
# ======================

# Number of messages to process in each batch (optional, defaults to 100)
# Higher values = more efficient but higher latency
# Lower values = lower latency but less efficient
# Recommended values:
#   - Light load (<100 stations): BATCH_SIZE=50
#   - Medium load (100-500 stations): BATCH_SIZE=100
#   - Heavy load (500-1000+ stations): BATCH_SIZE=200
BATCH_SIZE=100

# Interval between batch processing runs in milliseconds (optional, defaults to 500)
# Lower values = lower latency but more frequent MongoDB operations
# Higher values = higher latency but fewer MongoDB operations
# Processing capacity = BATCH_SIZE / (BATCH_INTERVAL_MS / 1000) records per second
# Example: 100 / 0.5 = 200 records/sec
# Recommended values:
#   - Low latency (<1 sec): BATCH_INTERVAL_MS=500
#   - Balanced (1-2 sec): BATCH_INTERVAL_MS=1000
#   - High efficiency (2-5 sec): BATCH_INTERVAL_MS=2000
BATCH_INTERVAL_MS=500

# ======================
# MQTT Configuration
# ======================

# MQTT broker hostname with protocol (required)
MQTT_HOST=mqtts://your-broker-url.hivemq.cloud

# MQTT credentials (required)
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password